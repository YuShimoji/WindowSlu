<UserControl x:Class="WindowSlu.Controls.IntegerEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="EditorRoot" Focusable="False">
 <UserControl.Resources>
  <ControlTemplate x:Key="Grip" TargetType="Thumb">
   <Grid Background="Transparent"><Ellipse Width="14" Height="14" Fill="{DynamicResource HighlightColor}" Stroke="{DynamicResource ForegroundColor}" StrokeThickness="1"/></Grid>
  </ControlTemplate>
  <Style x:Key="FineSlider" TargetType="Slider">
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent">
     <Border Height="6" Background="{DynamicResource BorderColor}" CornerRadius="3" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb x:Name="Thumb" Width="28" Height="28" Focusable="False" Template="{StaticResource Grip}" DragStarted="DragStarted" DragCompleted="DragCompleted"/></Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <WrapPanel VerticalAlignment="Center">
   <TextBlock x:Name="Caption" VerticalAlignment="Center" MinWidth="48" Margin="0,0,4,0"/>
   <TextBox x:Name="NumberBox" Width="58" TextChanged="NumberChanged" PreviewKeyDown="NumberKeyDown" ToolTip="Enter a whole number, then press Enter or Set. Escape restores the current value."/>
   <TextBlock Text="{Binding Unit, ElementName=EditorRoot}" VerticalAlignment="Center" Margin="3,0,4,0"/>
   <Button x:Name="SetButton" Content="Set" Click="SetClicked" MinWidth="32" Padding="3,1" Margin="0,0,5,0"/>
   <Button x:Name="MinusButton" Content="−" Click="MinusClicked" MinWidth="28" Padding="3,1"/>
   <Button x:Name="PlusButton" Content="+" Click="PlusClicked" MinWidth="28" Padding="3,1" Margin="2,0,5,0"/>
   <TextBlock Text="Step" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
   <ComboBox x:Name="StepPicker" Width="60" SelectionChanged="StepChanged" ToolTip="Choose a step. This does not change any value. ± moves to the next multiple; drag uses the chosen step."/>
  </WrapPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Slider x:Name="FineAdjustment" Style="{StaticResource FineSlider}" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderChanged" MinWidth="100"/>
   <Button x:Name="ValuesButton" Grid.Column="2" Content="Values ▾" Click="OpenValues" Padding="4,1" Margin="4,0,0,0" ToolTip="Set a common value"/>
   <TextBlock x:Name="RangeCaption" Grid.Column="1" VerticalAlignment="Center" FontSize="10" Margin="6,0,0,0"/>
  </Grid>
  <TextBlock x:Name="CurrentCaption" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
  <TextBlock x:Name="ErrorCaption" Visibility="Collapsed" Foreground="{DynamicResource ErrorForeground}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
