<Window x:Class="WindowSlu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowSlu.Models"
        xmlns:converters="clr-namespace:WindowSlu.Converters"
        xmlns:vm="clr-namespace:WindowSlu.ViewModels"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="WindowSlu" Height="450" Width="800"
        Icon="/WindowSlu;component/Assets/WindowSlu.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:BoolToTopMostTextConverter x:Key="BoolToTopMostTextConverter"/>
        <converters:PercentToWidthMultiConverter x:Key="PercentToWidthMultiConverter"/>
        
        <!-- CascadeDirection enum values for ComboBox -->
        <ObjectDataProvider x:Key="CascadeDirectionValues" MethodName="GetValues" ObjectType="{x:Type local:CascadeDirection}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:CascadeDirection"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- TreeView Expander Toggle Button Style -->
        <Style x:Key="ExpanderToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="ExpandPath"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 2 L 4 6 L 8 2 Z"
                                  Fill="{DynamicResource MutedForegroundColor}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base button style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Settings button style (for main content buttons) -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="Background" Value="{DynamicResource ControlColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHighlightColor}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
                    <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pin button style -->
        <Style x:Key="PinButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTopMost}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                </DataTrigger>
                 <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Icon ToggleButton Style -->
        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemSelectedColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentHighlightColor}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Pinned Toggle Button Style -->
        <Style x:Key="PinToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButtonStyle}">
            <Setter Property="Content" Value="📌"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
            <Setter Property="ToolTip" Value="Toggle Always on Top"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Click-Through Toggle Button Style -->
        <Style x:Key="ClickThroughToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButtonStyle}">
            <Setter Property="Content" Value="👻"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
            <Setter Property="ToolTip" Value="Toggle Click-Through"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Linked Drag Toggle Button Style (for group header) -->
        <Style x:Key="LinkedDragToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButtonStyle}">
            <Setter Property="Content" Value="🔗"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ToolTip" Value="Enable Linked Drag for this group"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Linked Drag Toggle Button Style (for individual windows) -->
        <Style x:Key="WindowLinkedDragToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButtonStyle}">
            <Setter Property="Content" Value="🔗"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ToolTip" Value="Include in Linked Drag"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reset Opacity Button Style -->
        <Style x:Key="ResetOpacityButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Content" Value="100%"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="ToolTip" Value="Reset opacity to 100%"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cascade Icon Button Style (for group header in Windows tab) -->
        <Style x:Key="CascadeButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Content" Value="&#xE8A9;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="ToolTip" Value="Cascade Arrange"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HighlightColor}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Themed Slider Style -->
        <ControlTemplate x:Key="SliderThumbStyle" TargetType="Thumb">
            <Grid Background="Transparent">
                <Ellipse x:Name="grip"
                         Fill="{DynamicResource HighlightColor}"
                         Stroke="{DynamicResource BorderColor}"
                         StrokeThickness="1"
                         Width="14" Height="14"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="grip" Property="Fill" Value="{DynamicResource AccentHighlightColor}"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                     <Setter TargetName="grip" Property="Fill" Value="{DynamicResource AccentHighlightColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        
        <Style x:Key="ThemedSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource HighlightColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground"
                                    Background="{DynamicResource BorderColor}"
                                    Height="12"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"/>
                            <Border x:Name="TrackValue"
                                    Background="{TemplateBinding Foreground}"
                                    Height="12"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                     <Border.Width>
                                        <MultiBinding Converter="{StaticResource PercentToWidthMultiConverter}">
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Focusable="False"
                                           Height="20"
                                           Width="20"
                                           OverridesDefaultStyle="True"
                                           Template="{StaticResource SliderThumbStyle}"
                                           VerticalAlignment="Center"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl and TabItem Styles -->
        <Style x:Key="ThemedTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="0,0,0,1"
                                Margin="0,0,-1,0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HighlightColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HighlightColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" 
                                    Background="{DynamicResource BackgroundColor}" 
                                    BorderBrush="{DynamicResource BorderColor}" 
                                    BorderThickness="0,1,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <tb:TaskbarIcon x:Key="NotifyIcon"
                        IconSource="/WindowSlu;component/Assets/WindowSlu.ico"
                        ToolTipText="WindowSlu"
                        TrayMouseDoubleClick="NotifyIcon_DoubleClick"
                        Visibility="Collapsed">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="ShowMenuItem_Click"/>
                    <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

    </Window.Resources>
    
    <Border Background="{DynamicResource BackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Image Source="/WindowSlu;component/Assets/WindowSlu.ico" Width="16" Height="16" Margin="5" Grid.Column="0"/>
                
                <TextBlock Grid.Column="1" 
                           Text="WindowSlu" 
                           Foreground="{DynamicResource ForegroundColor}"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left"
                           Margin="5,0"/>

                <Button Grid.Column="2" Content="&#xE793;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TitleBarButtonStyle}" Click="ThemeToggleButton_Click" ToolTip="Toggle Theme"/>
                <Button Grid.Column="3" Content="&#xE8A0;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TitleBarButtonStyle}" Click="TrayButton_Click" ToolTip="Minimize to Tray"/>
                <Button Grid.Column="4" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click"/>
                <Button Grid.Column="5" Content="&#xE739;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click"/>
                <Button Grid.Column="6" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TitleBarButtonStyle}" Click="CloseButton_Click"/>
            </Grid>
            
            <!-- Main Content -->
            <TabControl Grid.Row="1" Style="{DynamicResource ThemedTabControlStyle}">
                <TabItem Header="Windows" Style="{DynamicResource ThemedTabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- コントロールバー -->
                        <Grid Grid.Row="0" Margin="10,10,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左側: 一括不透明度設定 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bulk opacity:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}" Margin="0,0,5,0"/>
                                <Slider Style="{StaticResource ThemedSliderStyle}"
                                        Minimum="0" Maximum="100"
                                        Value="{Binding BulkOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"/>
                                <!-- 現在のBulk opacityを全ウィンドウに適用（小さなアイコンボタン） -->
                                <Button Click="SetAllTo80Percent_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Width="72"
                                        Height="24"
                                        Margin="12,0,0,0"
                                        ToolTip="Apply current bulk opacity to all windows">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8FB;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,4,0"
                                                   Foreground="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="{Binding BulkOpacityPercent, StringFormat={}{0}%}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentColor}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 右側: リセットボタン（100%） -->
                            <Button Grid.Column="1"
                                    Click="SetAllTo100Percent_Click"
                                    Style="{StaticResource SettingsButtonStyle}"
                                    Width="70"
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    ToolTip="Reset opacity of all windows to 100%">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="100%" Foreground="{DynamicResource AccentColor}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3*"/>
                            </Grid.RowDefinitions>

                            <!-- 上側: フラットなウィンドウ一覧 -->
                            <Border Grid.Row="0" Margin="10,0,10,5" Background="{DynamicResource CardBackgroundColor}" CornerRadius="4">
                                <DockPanel Margin="8">
                                    <!-- ヘッダー: タイトルとフィルタ -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="All Windows"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundColor}"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="0"/>
                                        <TextBlock Text="{Binding Windows.Count, StringFormat=({0})}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundColor}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"
                                                   Grid.Column="1"/>
                                        <Grid Grid.Column="2" Width="150">
                                            <TextBox x:Name="WindowFilterTextBox"
                                                     Text="{Binding WindowFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource BackgroundColor}"
                                                     Foreground="{DynamicResource ForegroundColor}"
                                                     BorderBrush="{DynamicResource BorderColor}"
                                                     FontSize="10"
                                                     VerticalContentAlignment="Center"
                                                     Padding="4,2"/>
                                            <TextBlock Text="🔍 Filter..."
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Margin="6,0,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundColor}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=WindowFilterTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                    <!-- 列ヘッダー -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="Title" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Grid.Column="2" Text="Process" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundColor}" Margin="8,0,0,0"/>
                                    </Grid>
                                    <ListView ItemsSource="{Binding FilteredWindows}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:WindowInfo}">
                                                <Grid Margin="0,2" MouseMove="WindowItem_MouseMove" Tag="{Binding}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Grid.Column="0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ForegroundColor}"
                                                               FontSize="11"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ProcessName}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedForegroundColor}"
                                                               FontSize="10"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>
                            </Border>

                            <!-- 中央: スプリッタ -->
                            <GridSplitter Grid.Row="1"
                                          HorizontalAlignment="Stretch"
                                          Height="5"
                                          Background="{DynamicResource BorderColor}"
                                          ShowsPreview="False"/>

                            <!-- 下側: 既存のグループ TreeView -->
                            <DockPanel Grid.Row="2">
                                <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                                    <TextBlock Text="Group name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="GroupNameTextBox" Width="140" Margin="0,0,5,0" ToolTip="Name for a new or selected manual group"/>
                                    <Button Content="New Group" Click="NewGroup_Click" Style="{StaticResource SettingsButtonStyle}"/>
                                    <Button Content="Rename" Click="RenameGroup_Click" Style="{StaticResource SettingsButtonStyle}"/>
                                    <Button Content="Delete Group" Click="DeleteGroup_Click" Style="{StaticResource SettingsButtonStyle}"/>
                                </WrapPanel>
                            <TreeView
                                      x:Name="WindowTreeView"
                                      ItemsSource="{Binding WindowGroups}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectedItemChanged="WindowTreeView_SelectedItemChanged">

                                <TreeView.Resources>
                                    <!-- グループヘッダーのテンプレート -->
                                    <HierarchicalDataTemplate DataType="{x:Type local:WindowGroup}" ItemsSource="{Binding Windows}">
                                        <Border Background="{DynamicResource CardBackgroundColor}" 
                                                BorderBrush="{DynamicResource BorderColor}" 
                                                BorderThickness="0,0,0,2" 
                                                CornerRadius="4" 
                                                Padding="8,6" 
                                                Margin="0,4,0,2"
                                                AllowDrop="True" Drop="GroupHeader_Drop" DragOver="GroupHeader_DragOver" Tag="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Row 0: グループ名・連動ドラッグ・カスケード -->
                                                <Image Source="{Binding GroupIcon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
                                                
                                                <TextBlock Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ForegroundColor}"/>
                                                    <Run Text=" (" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                    <Run Text="{Binding WindowCount, Mode=OneWay}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                    <Run Text=")" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                </TextBlock>

                                                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                                                    <!-- 連動ドラッグ有効/無効トグル -->
                                                    <ToggleButton Style="{StaticResource LinkedDragToggleButtonStyle}"
                                                                  IsChecked="{Binding LinkedDragEnabled, Mode=TwoWay}"
                                                                  ToolTip="Enable Linked Drag for this group"/>
                                                    <!-- Cascadeアイコンボタン -->
                                                    <Button Style="{StaticResource CascadeButtonStyle}"
                                                            Click="CascadeButton_Click"
                                                            Tag="{Binding}"/>
                                                </StackPanel>

                                            <!-- Row 1: グループ一括制御（透明度・サイズ） -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                <!-- 一括透明度スライダー -->
                                                <TextBlock Text="Opacity:" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" FontSize="10" Margin="0,0,4,0"/>
                                                <Slider x:Name="GroupOpacitySlider"
                                                        Style="{StaticResource ThemedSliderStyle}"
                                                        Minimum="0" Maximum="100" 
                                                        Value="100"
                                                        Width="80"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="GroupOpacitySlider_ValueChanged"
                                                        Tag="{Binding}"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" FontSize="10" Margin="2,0,4,0"/>
                                                <Button Style="{StaticResource ResetOpacityButtonStyle}"
                                                        Click="GroupResetOpacity_Click"
                                                        Tag="{Binding}"
                                                        Margin="0,0,10,0"/>
                                                
                                                <!-- 一括サイズ設定 -->
                                                <TextBlock Text="Size:" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" FontSize="10" Margin="0,0,4,0"/>
                                                <TextBox x:Name="GroupWidthTextBox"
                                                         Width="45" Height="18" FontSize="10"
                                                         Text="800"
                                                         VerticalContentAlignment="Center"
                                                         Background="{DynamicResource BackgroundColor}"
                                                         Foreground="{DynamicResource ForegroundColor}"
                                                         BorderBrush="{DynamicResource BorderColor}"
                                                         Tag="{Binding}"/>
                                                <TextBlock Text="x" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" FontSize="10" Margin="2,0,2,0"/>
                                                <TextBox x:Name="GroupHeightTextBox"
                                                         Width="45" Height="18" FontSize="10"
                                                         Text="600"
                                                         VerticalContentAlignment="Center"
                                                         Background="{DynamicResource BackgroundColor}"
                                                         Foreground="{DynamicResource ForegroundColor}"
                                                         BorderBrush="{DynamicResource BorderColor}"
                                                         Tag="{Binding}"/>
                                                <Button Content="Apply" 
                                                        FontSize="10" 
                                                        Width="40" Height="22" Padding="2,0"
                                                        Margin="4,0,0,0"
                                                        Click="GroupSizeApply_Click"
                                                        Tag="{Binding}"
                                                        ToolTip="Apply size to all windows in this group"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </HierarchicalDataTemplate>

                                    <!-- ウィンドウアイテムのテンプレート -->
                                    <DataTemplate DataType="{x:Type local:WindowInfo}">
                                        <Grid Margin="0,3" MouseMove="WindowItem_MouseMove" Tag="{Binding}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="ActiveBorder" Background="{DynamicResource AccentHighlightColor}" Opacity="0.3" CornerRadius="3" Margin="-2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- 1行目: タイトル・不透明度・ピン/クリックスルー/連動ドラッグ -->
                                            <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
                                            
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Title}" 
                                                       VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       Foreground="{DynamicResource ForegroundColor}"
                                                       FontSize="12"/>

                                            <Grid Grid.Column="2" Grid.Row="0" VerticalAlignment="Center">
                                                <Slider Style="{StaticResource ThemedSliderStyle}"
                                                        Minimum="0" Maximum="100" 
                                                        Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="OpacitySlider_ValueChanged"/>
                                                <TextBlock Text="{Binding Opacity, StringFormat={}{0}%}" 
                                                           FontSize="9"
                                                           IsHitTestVisible="False"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedForegroundColor}"/>
                                            </Grid>
                                            
                                            <ToggleButton Style="{StaticResource PinToggleButtonStyle}" 
                                                          IsChecked="{Binding IsTopMost, Mode=OneWay}"
                                                          Grid.Column="3" Grid.Row="0"
                                                          ToolTip="Toggle Always on Top"
                                                          Click="PinButton_Click"/>

                                            <ToggleButton Style="{StaticResource ClickThroughToggleButtonStyle}"
                                                          IsChecked="{Binding IsClickThrough, Mode=OneWay}"
                                                          Grid.Column="4" Grid.Row="0"
                                                          ToolTip="Toggle Click-Through"
                                                          Click="ClickThroughButton_Click"/>

                                            <!-- 連動ドラッグに含めるかどうかのトグル -->
                                            <ToggleButton Style="{StaticResource WindowLinkedDragToggleButtonStyle}"
                                                          IsChecked="{Binding IncludeInLinkedDrag, Mode=TwoWay}"
                                                          Grid.Column="5" Grid.Row="0"
                                                          ToolTip="Include in Linked Drag"/>

                                            <!-- 2行目: サイズ調整スライダー（幅・高さ） -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Size:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}" Margin="0,0,5,0" FontSize="10"/>
                                                <TextBlock Text="W" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,3,0" FontSize="10"/>
                                                <Slider Minimum="200" Maximum="3000"
                                                        Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="WindowWidthSlider_ValueChanged"
                                                        Width="100"/>
                                                <TextBlock Text="H" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" Margin="10,0,3,0" FontSize="10"/>
                                                <Slider Minimum="200" Maximum="3000"
                                                        Value="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="WindowHeightSlider_ValueChanged"
                                                        Width="100"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="Bd"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ToggleButton x:Name="Expander"
                                                                              ClickMode="Press"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                              Style="{StaticResource ExpanderToggleButtonStyle}"
                                                                              Width="16" Height="16"/>
                                                                <ContentPresenter x:Name="PART_Header"
                                                                                  Grid.Column="1"
                                                                                  ContentSource="Header"
                                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="false">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="HasItems" Value="false">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                        <!-- 選択時の背景色は変えず、ホバー時のみ色を付ける -->
                                                        <Trigger Property="IsSelected" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverColor}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Presets" Style="{DynamicResource ThemedTabItemStyle}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- プリセット選択 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Presets" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ForegroundColor}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetComboBox" 
                                          ItemsSource="{Binding PresetService.Presets}"
                                          DisplayMemberPath="Name"
                                          Grid.Column="0"
                                          Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Apply" Click="ApplyPreset_Click" Style="{StaticResource SettingsButtonStyle}" Width="70"/>
                                    <Button Content="Capture" Click="CapturePreset_Click" Style="{StaticResource SettingsButtonStyle}" Width="70" ToolTip="Capture the selected window or group from Windows"/>
                                    <Button Content="New" Click="NewPreset_Click" Style="{StaticResource SettingsButtonStyle}" Width="60"/>
                                    <Button Content="Delete" Click="DeletePreset_Click" Style="{StaticResource SettingsButtonStyle}" Width="70"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- プリセット設定 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding ElementName=PresetComboBox, Path=SelectedItem}">
                                <TextBlock Text="Preset Settings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}" Margin="0,10,0,10"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                             BorderBrush="{DynamicResource BorderColor}"/>
                                </Grid>

                                <!-- ターゲットフィルタ設定 -->
                                <TextBlock Text="Target Filter (optional)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Process:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}" FontSize="11"/>
                                    <TextBox Grid.Column="1" Text="{Binding TargetProcessName, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                             BorderBrush="{DynamicResource BorderColor}" FontSize="11"
                                             ToolTip="プロセス名でフィルタ（例: notepad, chrome）。空欄の場合は全てに適用"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Group:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}" FontSize="11"/>
                                    <DockPanel Grid.Column="1">
                                    <Button DockPanel.Dock="Right" Content="Clear" Click="ClearPresetGroup_Click" Style="{StaticResource SettingsButtonStyle}" ToolTip="Remove the target group filter"/>
                                    <ComboBox
                                              SelectedValue="{Binding TargetGroupId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              ItemsSource="{Binding DataContext.WindowGroups, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="5,0" FontSize="11"
                                              ToolTip="ターゲットグループを選択。未選択の場合は全てに適用">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    </DockPanel>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hotkey:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}" FontSize="11"/>
                                    <TextBox x:Name="HotKeyTextBox" Grid.Column="1" 
                                             Text="{Binding HotKey, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                             BorderBrush="{DynamicResource BorderColor}" FontSize="11"
                                             ToolTip="ショートカットキー（例: F1, Ctrl+1, Ctrl+Shift+A）"
                                             PreviewKeyDown="HotKeyTextBox_PreviewKeyDown"/>
                                </Grid>

                                <TextBlock Text="Window Settings" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,10,0,5"/>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Size (WxH):" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                             BorderBrush="{DynamicResource BorderColor}"/>
                                    <TextBlock Grid.Column="2" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                    <TextBox Grid.Column="3" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                             BorderBrush="{DynamicResource BorderColor}"/>
                                </Grid>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opacity:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5,0"/>
                                        <TextBlock Text="{Binding Opacity, StringFormat={}{0}%}" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" Margin="5,0"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Always on Top" IsChecked="{Binding IsTopMost}" Margin="0,10" Foreground="{DynamicResource ForegroundColor}"/>

                                <TextBlock Text="Cascade Settings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}" Margin="0,15,0,10"/>
                                <CheckBox Content="Enable Cascade" IsChecked="{Binding EnableCascade}" Margin="0,5" Foreground="{DynamicResource ForegroundColor}"/>
                                
                                <Grid Margin="0,5" IsEnabled="{Binding EnableCascade}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset (X,Y):" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                    <TextBox Grid.Column="1" Text="{Binding CascadeOffsetX, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                             BorderBrush="{DynamicResource BorderColor}"/>
                                    <TextBlock Grid.Column="2" Text="," VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                    <TextBox Grid.Column="3" Text="{Binding CascadeOffsetY, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                             Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                             BorderBrush="{DynamicResource BorderColor}"/>
                                </Grid>

                                <Grid Margin="0,5" IsEnabled="{Binding EnableCascade}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Direction:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                    <ComboBox Grid.Column="1" 
                                              SelectedItem="{Binding CascadeDirection, Mode=TwoWay}" 
                                              ItemsSource="{Binding Source={StaticResource CascadeDirectionValues}}"
                                              Margin="5,0" Width="120" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Content="Save Presets" Click="SavePresets_Click" 
                                Style="{StaticResource SettingsButtonStyle}" 
                                HorizontalAlignment="Right" Margin="0,10,0,0" Width="100"/>
                    </Grid>
                </TabItem>
                <!-- Layouts タブ -->
                <TabItem Header="Layouts" Style="{DynamicResource ThemedTabItemStyle}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- レイアウト選択・操作 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Saved Layouts" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ForegroundColor}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LayoutComboBox" 
                                          ItemsSource="{Binding LayoutService.Layouts}"
                                          DisplayMemberPath="Name"
                                          Grid.Column="0"
                                          Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Restore" Click="RestoreLayout_Click" Style="{StaticResource SettingsButtonStyle}" Width="70" ToolTip="選択したレイアウトを復元"/>
                                    <Button Content="Capture" Click="CaptureLayout_Click" Style="{StaticResource SettingsButtonStyle}" Width="70" ToolTip="現在の配置を保存"/>
                                    <Button Content="Delete" Click="DeleteLayout_Click" Style="{StaticResource SettingsButtonStyle}" Width="70"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- レイアウト詳細 -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundColor}" CornerRadius="4" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding ElementName=LayoutComboBox, Path=SelectedItem}">
                                    <TextBlock Text="Layout Details" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Name:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"
                                                 Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                                 BorderBrush="{DynamicResource BorderColor}"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Windows:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Entries.Count, StringFormat={}{0} windows}" 
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" Margin="5,0"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Modified:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundColor}" Margin="5,0"/>
                                    </Grid>

                                    <!-- ウィンドウエントリ一覧 -->
                                    <TextBlock Text="Window Entries" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,15,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Entries}" MaxHeight="200">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="5,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TitlePattern}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}" 
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBlock Grid.Column="2" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center">
                                                            <Run Text="{Binding Width, StringFormat={}{0}}"/>
                                                            <Run Text="x"/>
                                                            <Run Text="{Binding Height, StringFormat={}{0}}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 操作ボタン -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Update" Click="UpdateLayout_Click" Style="{StaticResource SettingsButtonStyle}" Width="80" ToolTip="現在の配置でレイアウトを更新"/>
                            <Button Content="Save All" Click="SaveLayouts_Click" Style="{StaticResource SettingsButtonStyle}" Width="80"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Settings" Style="{DynamicResource ThemedTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                        <StackPanel>
                            <TextBlock Text="Appearance" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ForegroundColor}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <Button Content="Light" Click="LightTheme_Click" Style="{StaticResource SettingsButtonStyle}"/>
                                <Button Content="Dark" Click="DarkTheme_Click" Style="{StaticResource SettingsButtonStyle}"/>
                            </StackPanel>

                            <CheckBox Content="Ctrl+MouseWheel adjusts window opacity" IsChecked="{Binding SettingsService.Settings.MouseWheelOpacityEnabled}" Foreground="{DynamicResource ForegroundColor}" Margin="0,15,0,5"/>
                            <Button Content="Save Preferences" Click="SavePreferences_Click" Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Hotkeys" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ForegroundColor}" Margin="0,20,0,10"/>
                            <CheckBox Content="Enable global hotkeys" 
                                      IsChecked="{Binding SettingsService.Settings.HotkeysEnabled}"
                                      Margin="0,0,0,10"
                                      Foreground="{DynamicResource ForegroundColor}"/>
                            <ItemsControl x:Name="HotkeySettingsList" ItemsSource="{Binding SettingsService.Settings.HotkeySettings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="10" CornerRadius="5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Content="{Binding Action}" IsChecked="{Binding IsEnabled}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource ForegroundColor}"/>
                                                
                                                <TextBox Text="{Binding Keys}" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource ForegroundColor}" Background="{DynamicResource BackgroundColor}"/>

                                                <Button Content="Edit" Click="EditHotkey_Click" Tag="{Binding}" Grid.Column="2" Style="{StaticResource SettingsButtonStyle}" Width="60"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Save Hotkeys" Click="SaveHotkeys_Click" Style="{StaticResource SettingsButtonStyle}" Width="100"/>
                                <Button Content="Reset to Defaults" Click="ResetHotkeys_Click" Style="{StaticResource SettingsButtonStyle}" Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Help" Style="{DynamicResource ThemedTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ForegroundColor}" LineHeight="22">
                            <Run Text="Select a window or group in Windows, then use its controls or apply a preset."/><LineBreak/><LineBreak/>
                            <Run Text="Groups: enter a name and choose New Group. The selected window is added. Drag window rows onto group headers to move them. Rename and Delete Group apply to the selected manual group."/><LineBreak/><LineBreak/>
                            <Run Text="Presets: Capture saves current settings. Target Process and Group always limit the application, including tray menus and hotkeys. A selection narrows these filters. Save Presets saves both presets and groups."/><LineBreak/><LineBreak/>
                            <Run Text="Layouts: Capture saves the current arrangement. Restore skips ambiguous matches and reports missing or failed windows. Hover over the status text for details."/><LineBreak/><LineBreak/>
                            <Run Text="Shortcuts: enable Hotkeys in Settings and save. Ctrl+MouseWheel changes opacity while enabled; turn it off in Settings to use another application's zoom."/><LineBreak/><LineBreak/>
                            <Run Text="Recovery: use the ghost toggle to disable click-through. Use 100% to make windows visible. Keep WindowSlu accessible in the taskbar or tray."/>
                        </TextBlock>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="About" Style="{DynamicResource ThemedTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                        <StackPanel>
                            <TextBlock Text="WindowSluへようこそ" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="このアプリケーションは、ウィンドウの透明度調整や最前面表示を簡単に行うためのツールです。" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="現在利用可能な機能" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="■ 透明度の調整" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBlock Text="・リスト内のスライダーを操作して、各ウィンドウの透明度を調整できます。" TextWrapping="Wrap"/>
                            <TextBlock Text="・ホットキー: Ctrl + Alt + ↑ / ↓" TextWrapping="Wrap"/>
                            
                            <TextBlock Text="■ 最前面表示 (ピン留め)" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBlock Text="・リスト右側の 📌 アイコンをクリックすると、そのウィンドウが常に最前面に表示されます。もう一度クリックすると解除されます。" TextWrapping="Wrap"/>
                            <TextBlock Text="・ホットキー: Ctrl + Alt + T" TextWrapping="Wrap"/>

                            <TextBlock Text="--- 開発中の機能 ---" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,20,0,5"/>
                            <TextBlock Text="・クリックスルー (👻)" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                            <TextBlock Text="・全ウィンドウの一括操作" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            
            <!-- Bottom Bar -->
            <DockPanel Grid.Row="2" LastChildFill="True">
                <StatusBar Background="Transparent" BorderThickness="0">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusText}" ToolTip="{Binding OperationDetails}" Foreground="{DynamicResource ForegroundColor}"/>
                    </StatusBarItem>
                </StatusBar>
            </DockPanel>

            <Border x:Name="TransparencyIndicator"
                    Grid.Row="0" Grid.RowSpan="3"
                    Background="#7F000000"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Visibility="Collapsed">
                <TextBlock x:Name="TransparencyValueText"
                           Text="80%"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>